{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pevc_path_bundle.schema.json",
  "title": "PEVC Path Identification Bundle v0.3.2",
  "type": "object",
  "$defs": {
    "investor_entity": {
      "type": "object",
      "required": [
        "investor_entity_id",
        "company_id",
        "investor_name_normalized",
        "pevc_candidate_status",
        "evidence_ids"
      ],
      "additionalProperties": true
    },
    "investment_path": {
      "type": "object",
      "required": [
        "investment_path_id",
        "company_id",
        "investor_entity_id",
        "transaction_id",
        "entry_method",
        "direct_or_indirect",
        "evidence_ids"
      ],
      "additionalProperties": true
    }
  }
}
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "numeric_validation_bundle.schema.json",
  "title": "Transaction Numeric Validation Bundle v0.1.2",
  "type": "object",
  "$defs": {
    "validation_result": {
      "type": "object",
      "required": [
        "validation_id",
        "company_id",
        "rule_id",
        "validation_status",
        "disclosed_input_fact_ids"
      ],
      "additionalProperties": true
    },
    "calculated_fact": {
      "type": "object",
      "required": [
        "calculated_fact_id",
        "company_id",
        "event_id",
        "transaction_id",
        "formula",
        "input_fact_ids",
        "calculated_value",
        "value_type"
      ],
      "properties": {
        "value_type": {
          "const": "CALCULATED"
        }
      },
      "additionalProperties": true
    }
  }
}